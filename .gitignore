# build artifacts
target/
node_modules/
*.exe
*.bin
*.dll
*.pdb

# scratch / run dirs (never committed)
_pilot_scratch/
_ctrlrun/
_longrun/

# OS noise
.DS_Store
Thumbs.db

# local secrets (none expected; guard anyway)
*.env
*.local

# W-GO: raw control files contain illegal names (M19/B4) - never commit originals
evidence/S02/ctrl-go/
_pilot_scratch/

# instrument side-effects: a gate run leaves byte-coded caches next to its own source
__pycache__/
*.pyc
