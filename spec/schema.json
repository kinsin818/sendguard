{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sendguard-result-schema-v1",
  "title": "SENDGUARD measurement cell",
  "description": "Canonical schema for one SENDGUARD measurement cell. Frozen at S00 per julying; status words live in spec/canonical.md (closed set). Any unknown status word -> VOID.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format_version",
    "case_id",
    "case_group",
    "language",
    "os",
    "api_entry",
    "attempt",
    "name_source",
    "path_form",
    "longpath_mechanism",
    "create_result",
    "error_stage",
    "read_result",
    "os_legality_verdict",
    "harness_version",
    "started_at",
    "elapsed_ms"
  ],
  "properties": {
    "format_version": { "const": "1" },
    "case_id": { "type": "string" },
    "case_group": { "enum": ["trap", "ctrl", "tapi", "blind", "len"] },
    "language": { "enum": ["node", "python", "go", "java", "csharp", "rust"] },
    "os": { "enum": ["windows", "macos", "ubuntu"] },
    "os_version": { "type": "string" },
    "arch": { "type": "string" },
    "locale": { "type": "string" },
    "api_entry": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "name_encoding": { "enum": ["utf16_code_units", "code_points", "utf8_bytes"] },
    "name_source": { "type": "string", "description": "Hex-encoded sample name. Corpus discipline: never land a real forbidden name as a filesystem entry; hex only." },
    "path_form": { "enum": ["plain", "extended"] },
    "longpath_mechanism": { "enum": ["manifest", "prefix_rewrite", "none", "unknown"] },
    "create_result": { "enum": ["ok", "err_at_parse", "err_at_syscall", "hang"] },
    "error_stage": { "enum": ["parse", "syscall", "fs", "tool", "null"] },
    "error_code": { "type": "string" },
    "error_message": { "type": "string" },
    "bytes_written": { "type": ["integer", "null"] },
    "bytes_on_disk": { "type": ["integer", "null"] },
    "read_result": { "enum": ["ok", "eof", "err6", "hang"] },
    "roundtrip_ok": { "type": "boolean" },
    "enum_to_stat_agrees": { "type": "boolean" },
    "enum_api_entry": { "type": "string" },
    "os_legality_verdict": { "enum": ["legal", "illegal", "unknown"] },
    "mechanism_class": { "type": "string", "description": "Closed set in spec/canonical.md; dedup key for external divergence counts." },
    "attribution_layer": { "enum": ["L1", "L2", "L3", "L3_interaction"] },
    "sha256_self": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256_truth": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instrument_conflict": { "type": "boolean" },
    "control_pass": { "type": "boolean" },
    "instrument_red": { "type": "boolean" },
    "cross_reader": {
      "type": "object",
      "properties": {
        "builder": { "type": "string" },
        "reader": { "type": "string" },
        "found": { "type": "boolean" },
        "size": { "type": ["integer", "null"] },
        "read_result": { "enum": ["ok", "eof", "err6", "hang"] }
      }
    },
    "harness_version": { "type": "string" },
    "worker_id": { "type": "string" },
    "started_at": { "type": "string" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "env": {
      "type": "object",
      "properties": {
        "LongPathsEnabled": { "type": ["integer", "null"] },
        "dot3name": { "type": ["string", "null"] },
        "max_component": { "type": ["integer", "null"] },
        "unicode_version": { "type": ["string", "null"] },
        "toolchain": { "type": "string" }
      }
    }
  }
}
